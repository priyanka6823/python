his bis my own job')\n","class child(father,grandfather):\n","  def fun():\n","    print('this is my property')\n","\n","anil=CHILD()\n","anil.show()\n","anil.disply()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Jo404wAZNmlL","executionInfo":{"status":"ok","timestamp":1767181489672,"user_tz":-330,"elapsed":10,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"02a4b71d-ef4f-4b7a-d347-d7f6da4f9d01"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["this is my shopping mall\n","this bis my own job\n"]}]},{"cell_type":"code","source":["class Grandfather:\n","\n","\tdef __init__(self, grandfathername):\n","\t\tself.grandfathername = grandfathername\n","\n","# Intermediate class\n","class Father(Grandfather):\n","\tdef __init__(self, fathername, grandfathername):\n","\t\tself.fathername = fathername\n","\n","\t\t# invoking constructor of Grandfather class\n","\t\tGrandfather.__init__(self, grandfathername)\n","\n","# Derived class\n","class Son(Father):\n","\tdef __init__(self,sonname, fathername, grandfathername):\n","\t\tself.sonname = sonname\n","\n","\t\t# invoking constructor of Father class\n","\t\tFather.__init__(self, fathername, grandfathername)\n","\n","\tdef print_name(self):\n","\t\tprint('Grandfather name :', self.grandfathername)\n","\t\tprint(\"Father name :\", self.fathername)\n","\t\tprint(\"Son name :\", self.sonname)\n","\n","# Driver code\n","s1 = Son('Prince', 'Rampal', 'Lal mani')\n","print(s1.grandfathername)\n","s1.print_name()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"CqR6jl6M7jVS","executionInfo":{"status":"ok","timestamp":1767008785673,"user_tz":-330,"elapsed":11,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"6502132e-b90d-42f2-d5b9-bd569ab92427"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Lal mani\n","Grandfather name : Lal mani\n","Father name : Rampal\n","Son name : Prince\n"]}]},{"cell_type":"code","source":["#multi inheritane\n","\n","class father:\n","  def fun(self):\n","    print('this is my property')\n","class mother:\n","  def fun2(self):\n","    print('this my shop')\n","class child(father,mother):\n","  def fun3(self):\n","    print('this my job')\n","anil=child()\n","anil.fun()\n","anil.fun2()\n","anil.fun3()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qGsHSD8iOg6L","executionInfo":{"status":"ok","timestamp":1767182259122,"user_tz":-330,"elapsed":14,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"c0b133da-dcc3-4a50-a8dc-b2ecf92cec57"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["this is my property\n","this my shop\n","this my job\n"]}]},{"cell_type":"code","source":["#hirarichle\n","class parent:\n","  def fun1(self):\n","    print('this fun is in parent class')\n","class child1(parent):\n","  def fun2(self):\n","    print('this fun1 is in child1 class')\n","class child2(parent):\n","  def fun3(self):\n","    print('this fun3 is in child2 class')\n","\n","s1=child1()\n","s2=child2()\n","s1.fun1()\n","s1.fun2()\n","s2.fun1()\n","s2.fun3()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"inwYWzBW8wN3","executionInfo":{"status":"ok","timestamp":1767009646736,"user_tz":-330,"elapsed":15,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"1614f8b4-c148-4e4a-9b75-136b739124cd"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["this fun is in parent class\n","this fun1 is in child1 class\n","this fun is in parent class\n","this fun3 is in child2 class\n"]}]},{"cell_type":"code","source":["#hybrid\n","class school:\n","  def  fun1(self):\n","    print('this fun is in school class')\n","class std1(parent):\n","  def fun2(self):\n","    print('this fun1 is in std1 class')\n","class std2(parent):\n","  def fun3(self):\n","    print('this fun3 is in std2 class')\n","class std3(school):\n","  def fun4(self):\n","    print('this fun4 is std4 ' )\n","\n","s1=std3()\n","s2.fun1()\n","s2.fun3()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7cTD95yx_BYy","executionInfo":{"status":"ok","timestamp":1767009958143,"user_tz":-330,"elapsed":15,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"34766d79-ebda-49bb-c7b3-9709bca6efee"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["this fun is in parent class\n","this fun3 is in child2 class\n"]}]},{"cell_type":"markdown","source":["polymorphism"],"metadata":{"id":"H79pqoX0RbPv"}},{"cell_type":"code","source":["# methonoveriding\n","def fun():\n","  print('good morning')\n","def fun():\n","  print('good evening')\n","fun()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"61Qhivc-Ra6Z","executionInfo":{"status":"ok","timestamp":1767182399615,"user_tz":-330,"elapsed":10,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"16d9e08b-7683-4b9f-ccdf-ade388dd28b6"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["good evening\n"]}]},{"cell_type":"code","source":["# methodoveloading\n","class manger:\n","  def transcation(self):\n","    print('there is issue')\n","class tem_class:\n","  def transcation(self):\n","    print('there is issue solved')\n","\n","anil=tem_class()\n","anil.transcation()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qAawl8vdR4VB","executionInfo":{"status":"ok","timestamp":1767183091678,"user_tz":-330,"elapsed":7,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"1f983ae3-9dc5-4434-c9a8-8c634a8b9731"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["there is issue solved\n"]}]},{"cell_type":"code","source":["def fun(a=None,b=None):\n","  if a==None and b==None:\n","    print('iam uk')\n","  elif a==None and b!=None:\n","     print('iam usa')\n","  elif a!=None and b==None:\n","     print('iam india')\n","  else:\n","      print('iam some where')\n","fun(a=10)\n","fun(b=20)\n","fun(a=30)\n","fun(12,34)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"sUREKAQ0Up-U","executionInfo":{"status":"ok","timestamp":1767183498727,"user_tz":-330,"elapsed":10,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"2d0f38d5-e256-447a-ec75-6d6acce8119f"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["iam india\n","iam usa\n","iam india\n","iam some where\n"]}]},{"cell_type":"markdown","source":["abstract"],"metadata":{"id":"2pkTYcJNWGmw"}},{"cell_type":"code","source":["from abc import ABC, abstractmethod\n","class WHATSAPP_VERSION1(ABC):\n","  def chat(self):\n","    print('chat available')\n","\n","@abstractmethod\n","  def status():\n","    pass\n","class WHATSAP_VERSION2(WHATSAPP_VERSION1):\n","      def status(self):\n","        print('new change')\n","obj=WHATSAP_VERSION2()\n","obj.status()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Rk0svESYWFJi","executionInfo":{"status":"ok","timestamp":1767183916180,"user_tz":-330,"elapsed":10,"user":{"displayName":"Kottamula Priyanka","userId":"05550897165345624786"}},"outputId":"9246194b-64db-4496-d54e-db55399e85cd"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["new change\n"]}]},{"cell_type":"markdown","source":["constrocter exm"],"metadata":{"id":"v4FZdvsIEgUD"}},{"cell_type":"code","source":["\n","class employee:\n","  def __init__(self,id,name):\n","    self.id=id\n","    self.name=name\n","\n","  def display(self):\n","    print('id:%d \\nName:%s'%(self.id,self.name))\n","emp1=employee(121,'sita')\n","emp2=employee(124,'ram')\n","emp1.display()\n","emp2.display()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-DnjbIBsAKlw"